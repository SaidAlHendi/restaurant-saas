{
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "href": "mailto:support@mintlify.com",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"],
    "display": "header"
  },
  "$schema": "https://mintlify.com/docs.json",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "pages": [
      {
        "group": "Getting Started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Roles",
        "pages": [
          "roles/overview",
          "roles/owner",
          "roles/manager",
          "roles/cashier",
          "roles/kitchen",
          "roles/super",
          "roles/billing",
          "roles/support"
        ]
      },
      {
        "group": "Settings",
        "pages": ["settings/menu-look"]
      },
      {
        "group": "Subscriptions",
        "pages": ["subscriptions/plans", "subscriptions/billing"]
      },
      {
        "group": "Database",
        "pages": [
          "database/overview",
          "database/tenancy-identity",
          "database/catalog",
          "database/ordering",
          "database/billing",
          "database/admin-infra",
          "database/comparisons"
        ]
      }
    ]
  }
}
