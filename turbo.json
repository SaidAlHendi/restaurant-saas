{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "E2E_DATABASE_URL",
    "E2E_DATABASE_MIGRATION_URL",
    "REDIS_URL",
    "NODE_ENV",
    "APP_ROLE",
    "PORT",
    "LOG_LEVEL",
    "DATABASE_MIGRATION_URL",
    "DATABASE_WORKER_URL",
    "E2E_DATABASE_WORKER_URL",
    "DATABASE_ADMIN_URL",
    "E2E_DATABASE_ADMIN_URL",
    "JWT_ADMIN_SECRET",
    "JWT_ADMIN_TTL",
    "JWT_ACCESS_SECRET",
    "JWT_ACCESS_TTL",
    "COOKIE_SECURE",
    "SEED_PASSWORD",
    "CORS_ORIGINS",
    "JWT_ADMIN_SECRET",
    "API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:seed:demo": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:seed:images": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:reset-test": {
      "cache": false
    }
  }
}
