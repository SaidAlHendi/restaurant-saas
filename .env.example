# Runtime environment (development | test | production)
NODE_ENV=development

# Which processes to run in this Node process: api (HTTP only), worker (jobs only), or all
APP_ROLE=all

# HTTP port for the NestJS API (default 3000)
PORT=3000

# Primary Postgres (create DB: restaurant_saas)
# Option A — repo docker compose: user/pass postgres, port 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_saas
# Option B — existing ~/docker/local-db stack: password rootpass, same port 5432
# DATABASE_URL=postgresql://postgres:rootpass@localhost:5432/restaurant_saas

# Postgres for Jest e2e locally (create DB: restaurant_saas_test)
# Option A — repo compose postgres-test on port 5433
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/restaurant_saas_test
# Option B — second database on your existing postgres-dev (port 5432)
# DATABASE_URL_TEST=postgresql://postgres:rootpass@localhost:5432/restaurant_saas_test

# Redis for readiness checks, cache, and Socket.io adapter (docker compose redis on 6379)
REDIS_URL=redis://localhost:6379

# Pino log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Base URL for RTK Query in apps/web (include scheme, no trailing slash)
VITE_API_URL=http://localhost:3000

# Optional: Socket.io URL for web clients (defaults to API origin when unset)
# VITE_WS_URL=http://localhost:3000

# Optional: public site origin for canonical URLs in apps/site loaders
# PUBLIC_SITE_URL=http://localhost:5174

# Optional: CORS allowed origins for the API (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth placeholders (roadmap 2+ — do not commit real secrets)
# JWT_ACCESS_SECRET=change-me
# JWT_REFRESH_SECRET=change-me
# JWT_ACCESS_TTL=15m
# COOKIE_DOMAIN=localhost
