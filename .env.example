# Runtime environment (development | test | production)
NODE_ENV=development

# Which processes to run in this Node process: api (HTTP only), worker (jobs only), or all
APP_ROLE=all

# HTTP port for the NestJS API (default 3000)
PORT=3000

# Local Postgres: use your existing stack (e.g. ~/docker/local-db: postgres-dev on 5432, redis-dev on 6379).
# One-time: ./scripts/bootstrap-postgres.sh  (creates DBs + app_owner/app_user via 01-roles.sql)

# API runtime Postgres (app_user — passwords from infra/postgres/init/01-roles.sql)
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5432/restaurant_saas

# Migrations only (app_owner)
DATABASE_MIGRATION_URL=postgresql://app_owner:app_owner_dev@localhost:5432/restaurant_saas

# Outbox publisher worker (app_worker — run 01-roles.sql + GRANT CONNECT/USAGE per database)
DATABASE_WORKER_URL=postgresql://app_worker:app_worker_dev@localhost:5432/restaurant_saas
# Platform admin API (app_admin: BYPASSRLS, narrow grants - see migration 0013). Required for APP_ROLE api/all.
DATABASE_ADMIN_URL=postgresql://app_admin:app_admin_dev@localhost:5432/restaurant_saas
# Outbox publisher poll interval in ms (worker only, default 500)
# OUTBOX_PUBLISHER_INTERVAL_MS=500
# Max wait in ms for the outbox publisher to finish on shutdown (worker only, default 10000)
# OUTBOX_SHUTDOWN_TIMEOUT_MS=10000

# Jest e2e: always uses localhost:5432/restaurant_saas_test unless CI or E2E_* is set (see test/test-db-env.ts).
# Remove any old DATABASE_URL_TEST=...@localhost:5433 from .env — it is not used for e2e.
# Bundled compose test Postgres on 5433 — export before pnpm test:
#   export E2E_DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5433/restaurant_saas_test

# Redis (shared local-db redis-dev)
REDIS_URL=redis://localhost:6379

# Pino log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Auth (JWT_ACCESS_SECRET must be at least 32 characters)
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
# Admin tokens use their own secret (min 32 chars, must differ from JWT_ACCESS_SECRET)
JWT_ADMIN_SECRET=local-dev-jwt-admin-secret-min-32-chars-x
# JWT_ADMIN_TTL=10m
# First platform admin (read once by the CLI, min 12 chars; do not keep it in a deployed env):
#   ADMIN_PASSWORD=... pnpm --filter @app/api admin:create --email you@example.com --role super
# ADMIN_PASSWORD=
COOKIE_SECURE=false

# Seed script (pnpm db:seed)
SEED_PASSWORD=change-me-seed-password

# Dashboard SPA base URL for staff invite links (API builds /invite/:token URLs)
WEB_APP_URL=http://localhost:5173

# Optional: Unsplash API for pnpm db:seed:images (developer machine only; CI does not use this)
# UNSPLASH_ACCESS_KEY=

# Optional: Pixabay API for pnpm db:seed:images:pixabay (developer machine only). Free key at pixabay.com/api/docs/
# PIXABAY_API_KEY=

# Base URL for RTK Query in apps/web (:5173) and apps/admin (:5175). Include scheme, no trailing slash.
# Both default to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# Public menu site base URL for dashboard QR links (include scheme, no trailing slash)
VITE_PUBLIC_SITE_URL=http://localhost:5174

# Optional: Socket.io URL for web clients (defaults to API origin when unset)
# VITE_WS_URL=http://localhost:3000

# Public menu site (apps/site SSR loaders — server-side only, not exposed to the browser)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:5174

# CORS allowed origins for the API (comma-separated): web 5173, site 5174, admin 5175.
# Optional in development (all origins allowed when unset); REQUIRED when NODE_ENV=production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Paddle Billing (optional; checkoutEnabled requires API key + all three price ids)
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_MENU=pri_xxx
# PADDLE_PRICE_RESTAURANT=pri_yyy
# PADDLE_PRICE_BUSINESS=pri_zzz
# Web checkout (apps/web):
# VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_ENV=sandbox

# Object storage (local dev writes under apps/api/.storage, served at /v1/media when not production)
STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000/v1/media

# S3-compatible storage (required when STORAGE_DRIVER=s3, e.g. Cloudflare R2)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
