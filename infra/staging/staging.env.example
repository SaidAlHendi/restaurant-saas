# Copy to infra/staging/staging.env (git-ignored) and fill in. Never commit real values.
# Generate passwords and secrets with:  ./deploy.sh gen-secrets
# Use letters and digits only in passwords (they go into connection URLs): openssl rand -hex 24

# --- Database and cache (internal to the stack; nothing is exposed) ---
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_WORKER_PASSWORD=
APP_ADMIN_PASSWORD=
REDIS_PASSWORD=

# --- Auth secrets (two DIFFERENT random values, 32+ characters each) ---
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=

# --- Public addresses ---
# Browser origins allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=https://app-staging.getsahtain.com,https://admin-staging.getsahtain.com
# Dashboard address, used in staff invite links.
WEB_APP_URL=https://app-staging.getsahtain.com
# Public menu / landing site address (used in QR links and canonical URLs).
PUBLIC_SITE_URL=https://menu-staging.getsahtain.com

# --- Cloudflare Tunnel (from Zero Trust > Networks > Tunnels > your tunnel > token) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Image storage: Cloudflare R2 bucket with public access (staging has NODE_ENV=production,
#     so the local-disk driver is not available) ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sahtain-staging-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket, for example https://media-staging.getsahtain.com
S3_PUBLIC_BASE_URL=

# --- Optional ---
LOG_LEVEL=info
# Paddle sandbox (billing stays off while the key is empty)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MENU=
PADDLE_PRICE_RESTAURANT=
PADDLE_PRICE_BUSINESS=
# Landing page leads
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL_TO=
LEADS_NOTIFY_EMAIL_FROM=Sahtain <onboarding@resend.dev>
LEADS_NOTIFY_WEBHOOK_URL=
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
