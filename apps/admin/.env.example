# Base URL of the Sahtain API (server-side only; the browser never talks to it directly).
API_URL=http://localhost:3000
# Must match the API's JWT_ADMIN_SECRET. Used by the middleware to verify the admin session cookie.
JWT_ADMIN_SECRET=local-dev-jwt-admin-secret-min-32-chars-x
# Set to false when serving over plain http (local production build). Defaults to true in production.
# COOKIE_SECURE=false
